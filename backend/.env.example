# ============================================================
#  后端配置。所有敏感项只从环境变量读，绝不硬编码、绝不进前端。
#  复制本文件为 .env 后填写。
# ============================================================

# ---------- 应用 ----------
APP_NAME=pubmed-domain-analytics
VERSION=1.0.0
# 演示模式：关闭调试回显，开启统一错误处理
DEBUG=false

# ---------- 数据源模式 ----------
# local  = 只读 data/presets 下的预生成数据集（境内服务器直连 NCBI 不通时的默认）
# remote = 直连 NCBI E-utilities
# hybrid = 优先本地，缺失时回落远程
DATA_MODE=local

# ---------- NCBI E-utilities ----------
# API Key 在 https://www.ncbi.nlm.nih.gov/account/settings/ 申请
# 没有 Key 也能跑，但限流 3 req/s；有 Key 是 10 req/s
NCBI_API_KEY=
NCBI_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
# 建议填你自己的邮箱，NCBI 要求带 tool/email 才是正式用法，配额更宽松
NCBI_TOOL=pubmed-domain-analytics
NCBI_EMAIL=
NCBI_TIMEOUT=30
# 有 Key 时 10 req/s，无 Key 时 3 req/s，留一点余量
NCBI_MIN_INTERVAL=0.12

# ---------- 检索默认参数 ----------
DEFAULT_FETCH_COUNT=1000
MAX_FETCH_COUNT=5000
TOP_N_PAPERS=100
# 「近 5 年」的窗口（含当年，共 5 个年份）
RECENT_YEARS=5

# ---------- LLM ----------
# 留空则 AI 相关接口自动降级，页面其余部分照常工作
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 注意：deepseek-chat / deepseek-reasoner 已于 2026-07-24 弃用，别再用
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=90
LLM_MAX_RETRIES=2

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=8000
# 单次检索最多返回多少篇给前端做统计
CORS_ORIGINS=*
