# ===== 后端联调 =====
# 开发期 Vite proxy 把 /api 转发到这里；生产期静态文件与后端同源，不读这个变量。
VITE_PROXY_TARGET=http://127.0.0.1:8000
VITE_PORT=5173

# ===== Mock 开关（仅开发用）=====
# true  = 全程使用契约假数据，完全不请求后端（后端没起来也能独立验证）
# false = 走真实后端
VITE_USE_MOCK=true
# 后端不可达时是否自动回落到 mock（仅在 VITE_USE_MOCK=true 时有意义）。
# 现场演示建议开：后端挂了页面不会白屏，顶栏会出现「数据来源：Mock」提示条。
VITE_MOCK_FALLBACK=true
# 让 mock 的 AI 综述接口返回 degraded:true，用于演示降级路径
VITE_MOCK_REVIEW_DEGRADED=false
